# Contact form endpoint. Copy this file to .env.local and fill in your own value.
# The form POSTs JSON to this URL and expects a JSON response.
#
# FormSubmit:  https://formsubmit.co/ajax/<your-form-id-or-email>
# Formspree:   https://formspree.io/f/<your-form-id>
#
# If this is empty the form shows an error and points visitors to the email address instead.
VITE_FORM_ENDPOINT=
